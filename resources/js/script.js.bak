// 工具函数：格式化日期
function formatDate(dateString) {
    if (!dateString) return '未知日期';
    const date = new Date(dateString);
    return `${date.getFullYear()}-${(date.getMonth() + 1).toString().padStart(2, '0')}-${date.getDate().toString().padStart(2, '0')} ${date.getHours().toString().padStart(2, '0')}:${date.getMinutes().toString().padStart(2, '0')}`;
}

// 工具函数：显示错误信息
function showError(elementId, message) {
    const element = document.getElementById(elementId);
    element.textContent = message;
    element.style.display = 'block';
}

// 工具函数：清空表单错误信息
function clearFormErrors() {
    document.querySelectorAll('.error-message').forEach(element => {
        element.style.display = 'none';
    });
}

// 工具函数：验证邮箱格式
function isValidEmail(email) {
    const re = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    return re.test(email);
}

// 以下是功能函数，实际应用中需要与后端API交互

// 报名活动
async function registerActivity(activityId) {
    if (!currentUser) {
        alert('请先登录！');
        document.getElementById('loginModal').classList.add('active');
        return;
    }

    try {
        // 使用 api 对象报名活动
        await api.activities.register(activityId);

        alert('报名成功！');

        // 重新渲染活动页面
        renderActivities();
        updatePointsDisplay();
    } catch (error) {
        alert(error.message || '报名失败');
    }
}

// 捐赠
async function donate(donationId) {
    if (!currentUser) {
        alert('请先登录！');
        document.getElementById('loginModal').classList.add('active');
        return;
    }

    const amount = prompt('请输入捐赠金额（元）:');
    if (amount && !isNaN(amount) && parseFloat(amount) > 0) {
        const numAmount = parseFloat(amount);

        try {
            // 使用 api 对象进行捐赠
            await api.donations.donate(donationId, numAmount);

            alert(`捐赠成功！感谢您的爱心捐赠${numAmount}元。`);

            // 重新渲染捐赠页面
            renderDonations();
            updatePointsDisplay();
        } catch (error) {
            alert(error.message || '捐赠失败');
        }
    }
}

// 兑换商品
async function exchangeProduct(productId) {
    if (!currentUser) {
        alert('请先登录！');
        document.getElementById('loginModal').classList.add('active');
        return;
    }

    const userPoints = await calculateUserPoints();
    const product = await getProductDetail(productId);

    if (product && product.stock > 0 && userPoints >= product.points) {
        // 确认兑换
        if (confirm(`确定要兑换 ${product.name} 吗？将消耗 ${product.points} 积分。`)) {
            try {
                // 使用 api 对象兑换商品
                await api.products.exchange(productId);

                alert(`兑换成功！已消耗 ${product.points} 积分。`);

                // 重新渲染商品页面
                renderProducts();
                updatePointsDisplay();

                // 更新个人中心兑换记录
                if (document.getElementById('exchangesTab').classList.contains('active')) {
                    renderUserExchanges();
                }
            } catch (error) {
                alert(error.message || '兑换失败');
            }
        }
    } else {
        alert('积分不足或商品已无库存！');
    }
}

// 获取商品详情
async function getProductDetail(productId) {
    try {
        const url = buildUrl(API_ENDPOINTS.PRODUCT_DETAIL, { id: productId });
        const data = await apiRequest(url);
        return data.product || data;
    } catch (error) {
        console.error('获取商品详情错误:', error);
        return null;
    }
}

// 以下为管理员功能
async function editActivity(id) {
    try {
        // 获取活动详情
        const url = buildUrl(API_ENDPOINTS.ACTIVITY_DETAIL, { id });
        const data = await apiRequest(url);
        const activity = data.activity || data;

        document.getElementById('activityForm').style.display = 'block';
        document.getElementById('activityFormTitle').textContent = '编辑活动';
        document.getElementById('activityId').value = activity.id;
        document.getElementById('activityTitle').value = activity.title;
        document.getElementById('activityDescription').value = activity.description;
        document.getElementById('activityLocation').value = activity.location;
        document.getElementById('activityDate').value = activity.event_date.replace(' ', 'T').slice(0, 16);
        document.getElementById('activityMaxParticipants').value = activity.max_participants;
    } catch (error) {
        alert('获取活动详情失败');
    }
}

async function deleteActivity(id) {
    if (confirm('确定要删除这个活动吗？')) {
        try {
            const url = buildUrl(API_ENDPOINTS.ACTIVITY_DETAIL, { id });
            await apiRequest(url, {
                method: 'DELETE'
            });

            renderActivities();
            alert('活动已删除！');
        } catch (error) {
            alert(error.message || '删除失败');
        }
    }
}

async function editDonation(id) {
    try {
        // 获取捐赠项目详情
        const url = buildUrl(API_ENDPOINTS.DONATION_DETAIL, { id });
        const data = await apiRequest(url);
        const donation = data.donation || data;

        document.getElementById('donationForm').style.display = 'block';
        document.getElementById('donationFormTitle').textContent = '编辑捐赠项目';
        document.getElementById('donationId').value = donation.id;
        document.getElementById('donationTitle').value = donation.title;
        document.getElementById('donationDescription').value = donation.description;
        document.getElementById('donationTargetAmount').value = donation.target_amount;
    } catch (error) {
        alert('获取捐赠项目详情失败');
    }
}

async function toggleDonationStatus(id) {
    try {
        const url = buildUrl(API_ENDPOINTS.DONATION_DETAIL, { id });
        const donation = await apiRequest(url);

        const newStatus = donation.status === 'open' ? 'closed' : 'open';

        await apiRequest(url, {
            method: 'PUT',
            body: { status: newStatus }
        });

        alert(`已${newStatus === 'open' ? '开启' : '关闭'}捐赠项目`);
        renderDonations();
    } catch (error) {
        alert(error.message || '操作失败');
    }
}

async function editProduct(id) {
    try {
        // 获取商品详情
        const url = buildUrl(API_ENDPOINTS.PRODUCT_DETAIL, { id });
        const data = await apiRequest(url);
        const product = data.product || data;

        document.getElementById('productForm').style.display = 'block';
        document.getElementById('productFormTitle').textContent = '编辑商品';
        document.getElementById('productId').value = product.id;
        document.getElementById('productName').value = product.name;
        document.getElementById('productDescription').value = product.description;
        document.getElementById('productPoints').value = product.points;
        document.getElementById('productStock').value = product.stock;
    } catch (error) {
        alert('获取商品详情失败');
    }
}

async function deleteProduct(id) {
    if (confirm('确定要删除这个商品吗？')) {
        try {
            const url = buildUrl(API_ENDPOINTS.PRODUCT_DETAIL, { id });
            await apiRequest(url, {
                method: 'DELETE'
            });

            renderProducts();
            alert('商品已删除！');
        } catch (error) {
            alert(error.message || '删除失败');
        }
    }
}